# Copiar este archivo como .env y completar los valores

# Personal Access Token de Jira (generarlo en: Jira → perfil → Personal Access Tokens)
JIRA_TOKEN=

# Webhook del canal de Google Chat (generarlo en: canal → Manage webhooks → Add webhook)
GOOGLE_CHAT_WEBHOOK=

# Filtro de dominio para el recordatorio (valor del campo Domain en Jira)
# Ejemplos: eLoyalty, eHotel, ePackage
DOMAIN_FILTER=eLoyalty

# Título del mensaje en Google Chat (opcional, por defecto usa DOMAIN_FILTER + " Experiments")
REMINDER_TITLE=eLoyalty Experiments
